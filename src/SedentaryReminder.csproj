<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TickNote</AssemblyName>
    <RootNamespace>SedentaryReminder</RootNamespace>
    <ApplicationIcon>Assets\TickNote.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <AssemblyInformationalVersion>1.0.2</AssemblyInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- 托盘进度环要在图标上叠画，需要原图；窗口图标也用它（IcoResource 逻辑名见 DpiForm） -->
    <EmbeddedResource Include="Assets\TickNote.png" />
    <EmbeddedResource Include="Assets\TickNote.ico" />
  </ItemGroup>

</Project>
