<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TickNote</AssemblyName>
    <RootNamespace>SedentaryReminder</RootNamespace>
    <ApplicationIcon>Assets\TickNote.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <AssemblyInformationalVersion>1.0.3</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SafeFileVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[^0-9A-Za-z.-]', '-'))</SafeFileVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- 托盘进度环要在图标上叠画，需要原图；窗口图标也用它（IcoResource 逻辑名见 DpiForm） -->
    <EmbeddedResource Include="Assets\TickNote.png" />
    <EmbeddedResource Include="Assets\TickNote.ico" />
  </ItemGroup>

  <!-- 只修改发布产物文件名，程序集名保持 TickNote，避免影响资源名和运行时逻辑。
       SafeFileVersion 会把非 ASCII 安全字符替换为连字符。 -->
  <Target Name="UseVersionedPublishFileName"
          AfterTargets="Publish"
          Condition="'$(PublishSingleFile)' == 'true' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <ItemGroup>
      <_PreviousVersionedExecutables Include="$(PublishDir)$(AssemblyName)-v*.exe" />
    </ItemGroup>
    <Delete Files="@(_PreviousVersionedExecutables)" />
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(PublishDir)$(AssemblyName)-v$(SafeFileVersion).exe" />
  </Target>

</Project>
