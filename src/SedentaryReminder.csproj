<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TickNote</AssemblyName>
    <RootNamespace>SedentaryReminder</RootNamespace>
    <ApplicationIcon>Assets\TickNote.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <AssemblyInformationalVersion>1.0.4</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- 托盘进度环要在图标上叠画，需要原图；窗口图标也用它（IcoResource 逻辑名见 DpiForm） -->
    <EmbeddedResource Include="Assets\TickNote.png" />
    <EmbeddedResource Include="Assets\TickNote.ico" />
  </ItemGroup>

  <!-- 发布产物固定为 TickNote.exe（不带版本号）：开机自启注册表记录的是 EXE 全路径，
       文件名一旦带版本号，升级换新文件后旧路径失效、重启后无法自启。
       固定文件名后升级 = 直接覆盖同名文件；版本号看"关于"窗口或文件属性。 -->

</Project>
